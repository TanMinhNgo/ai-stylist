# Chỉ chứa khóa công khai (tiền tố EXPO_PUBLIC_), không đặt secret ở đây.

# npm run dev (thư mục gốc) tự gán địa chỉ LAN của API mỗi lần chạy.
# Chỉ bỏ comment khi chạy Expo riêng, ví dụ:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Giai đoạn 1: Clerk Dashboard > API keys > Publishable key (pk_test_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Giai đoạn 2: ImageKit Dashboard > Developer options
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Giai đoạn 7: RevenueCat > Project > API keys > Public app-specific key (appl_... / goog_...).
# Để trống thì app không mở mua/khôi phục gói; quyền gói luôn do API xác minh.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
