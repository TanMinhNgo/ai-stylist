# AI Stylist API — copy this file to apps/api/.env and fill your own values.
# Never commit real credentials. HTTP, Neon, Redis and Clerk are used by BE-01;
# ImageKit and OpenAI vision/embeddings are used by BE-02.

# HTTP server (phase 0). API listens on 0.0.0.0; dev launcher detects LAN IP.
PORT=3000
# Browser origins only, separated by commas. Native Expo does not need CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Neon PostgreSQL / Prisma (BE-01).
# Both URLs must point to the SAME branch, database and role.
# In Neon Console > Connect, select the branch/database/role:
# enable connection pooling for DATABASE_URL; disable it for DIRECT_URL.
# Pooled URL (hostname contains -pooler): normal API/worker queries.
# Example: postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=
# Direct URL (hostname without -pooler): Prisma CLI migrations/schema changes.
# Example: postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DB?sslmode=require
# Keep the full SSL/query settings supplied by Neon for each URL.
DIRECT_URL=

# Redis / BullMQ queues (BE-01). Local Redis must be running on this port.
# Use the provider's redis:// or rediss:// URL when deploying (rediss uses TLS).
REDIS_URL=redis://localhost:6379

# Clerk server credentials (BE-01), from the same Clerk app as mobile.
# Dashboard > API Keys: backend publishable key (pk_test_... / pk_live_...).
CLERK_PUBLISHABLE_KEY=
# Dashboard > API Keys: backend secret key (sk_test_... / sk_live_...).
CLERK_SECRET_KEY=
# Leave empty for this native Expo app: native tokens have no azp claim.
# Independent from CORS_ORIGINS; there is no fallback to browser CORS origins.
# For a web-only client, set allowed frontend origins explicitly. A non-empty
# list also requires azp, so it rejects native tokens without that claim.
CLERK_AUTHORIZED_PARTIES=
# Dashboard > Webhooks > your API endpoint > Signing Secret (whsec_...).
# This is a separate secret used to verify webhook signatures.
CLERK_WEBHOOK_SECRET=

# ImageKit (BE-02), from Dashboard > Developer / API keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Your account's URL endpoint, e.g. https://ik.imagekit.io/YOUR_IMAGEKIT_ID
IMAGEKIT_URL_ENDPOINT=

# OpenAI API (spike 0A and later AI providers). Server-only API key.
# Verified model IDs against official docs on 2026-10-10; access not tested.
OPENAI_API_KEY=
# BE-03 image editing candidate. Evaluate quality and cost in phase 0A.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Image analysis, garment tagging and stylist advice (text/JSON output).
OPENAI_VISION_MODEL=gpt-6.1-sol
# Text embeddings. BE-02 requests 1024 dimensions to match vector(1024).
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# BE-03: openai uses the configured key/model; fake returns a fixed mock PNG.
# fake is only for local/test and is rejected when NODE_ENV=production.
TRYON_PROVIDER=openai

# BE-04 advice/suggestions use OPENAI_VISION_MODEL. Fake only local/test.
STYLIST_PROVIDER=openai

# Mannequin assets: initial rollout is opt-in. Shared daily limit: 5 images/user.
# Idea proposals have a separate 10/day cap; reset at midnight Asia/Saigon.
ASSET_PROVIDER=openai
ASSET_GENERATION_ENABLED=false
# Comma-separated internal User UUIDs from GET /me. In production a non-empty
# allowlist is required. Empty list permits authenticated local/test users only.
ASSET_GENERATION_USER_IDS=
