generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  clerkUserId    String    @unique @map("clerk_user_id")
  email          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  clerkUpdatedAt BigInt    @default(0) @map("clerk_updated_at")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  uploadGrants   UploadGrant[]
  modelPhotos    ModelPhoto[]
  garments       Garment[]
  tryOnJobs      TryOnJob[]
  outfits        Outfit[]
  assetJobs      AssetJob[]
  styleProfile   StyleProfile?
  stylistJobs    StylistJob[]
  usageLedger    UsageLedger[]
  deletion       AccountDeletion?
  workLeases     WorkLease[]
  aiCalls        AiCall[]

  @@map("users")
}

model UploadGrant {
  token           String   @id @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  folder          String   @unique
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  imagekitFileId  String?  @unique @map("imagekit_file_id")
  user            User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId])
  @@map("upload_grants")
}

model ModelPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  imagekitFileId String   @unique @map("imagekit_file_id")
  filePath       String   @map("file_path")
  status         String   @default("pending")
  errorCode      String?  @map("error_code")
  analysis       Json?
  promptVersion  String?  @map("prompt_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId, createdAt, id])
  @@map("model_photos")
}

model Garment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  imagekitFileId String   @unique @map("imagekit_file_id")
  filePath       String   @map("file_path")
  status         String   @default("pending")
  errorCode      String?  @map("error_code")
  category       String?
  tags           Json?
  embedding      Unsupported("vector(1024)")?
  promptVersion  String?  @map("prompt_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source         String   @default("user_photo")
  generateAsset  Boolean  @default(false) @map("generate_asset")
  assetBodyKey   String   @default("f") @map("asset_body_key")
  requestedType  String?  @map("requested_type")
  assetErrorCode String?  @map("asset_error_code")
  deletingAt     DateTime? @map("deleting_at") @db.Timestamptz(3)
  currentAssetId String?  @map("current_asset_id") @db.Uuid
  currentAsset   AssetJob? @relation("CurrentAsset", fields: [currentAssetId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assetJobs      AssetJob[] @relation("GarmentAssets")
  @@index([userId, createdAt, id])
  @@index([userId, category])
  @@map("garments")
}

model AssetJob {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  batchKey            String   @map("batch_key")
  itemIndex           Int      @map("item_index")
  requestHash         String   @map("request_hash")
  kind                String
  input               Json
  bodyKey             String   @map("body_key")
  garmentId           String?  @map("garment_id") @db.Uuid
  status              String   @default("queued")
  provider            String
  imageModel          String   @map("image_model")
  promptVersion       String   @default("asset-v1") @map("prompt_version")
  errorCode           String?  @map("error_code")
  generationStartedAt DateTime? @map("generation_started_at") @db.Timestamptz(3)
  quotaDay            String   @map("quota_day")
  refundedAt          DateTime? @map("refunded_at") @db.Timestamptz(3)
  resultFileId        String?  @unique @map("result_file_id")
  resultFilePath      String?  @map("result_file_path")
  renderMeta          Json?    @map("render_meta")
  proposals           Json?
  deadlineAt          DateTime @map("deadline_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  garment             Garment? @relation("GarmentAssets", fields: [garmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentFor          Garment[] @relation("CurrentAsset")
  @@unique([userId, batchKey, itemIndex])
  @@index([userId, quotaDay, kind, refundedAt])
  @@index([status, deadlineAt])
  @@map("asset_jobs")
}

model TryOnJob {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  idempotencyKey      String   @map("idempotency_key")
  requestHash         String   @map("request_hash")
  queuePriority       Int      @default(10) @map("queue_priority")
  modelPhotoId        String   @map("model_photo_id") @db.Uuid
  garmentIds          String[] @map("garment_ids") @db.Uuid
  occasion            String
  status              String   @default("queued")
  provider            String
  imageModel          String   @map("image_model")
  promptVersion       String   @default("tryon-v1") @map("prompt_version")
  errorCode           String?  @map("error_code")
  generationStartedAt DateTime? @map("generation_started_at") @db.Timestamptz(3)
  resultFileId        String?  @unique @map("result_file_id")
  resultFilePath      String?  @map("result_file_path")
  refundedAt          DateTime? @map("refunded_at") @db.Timestamptz(3)
  deadlineAt          DateTime @map("deadline_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outfit              Outfit?
  @@unique([userId, idempotencyKey])
  @@index([status, deadlineAt])
  @@map("tryon_jobs")
}

model UsageLedger {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  delta Int
  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([jobId,delta])
  @@index([userId,periodStart])
  @@map("usage_ledger")
}

model AccountDeletion {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  status String @default("queued")
  retryAt DateTime @default(now()) @map("retry_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([status,retryAt])
  @@map("account_deletions")
}

model WorkLease {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([userId,expiresAt])
  @@map("work_leases")
}

model AiCall {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  jobId String @map("job_id") @db.Uuid
  kind String
  model String
  status String @default("started")
  inputTokens Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")
  estimatedUsd Float? @map("estimated_usd")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([userId,createdAt])
  @@map("ai_calls")
}

model Outfit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tryOnJobId     String   @unique @map("tryon_job_id") @db.Uuid
  imagekitFileId String   @unique @map("imagekit_file_id")
  filePath       String   @map("file_path")
  advice         Json?
  garmentSnapshot Json? @map("garment_snapshot")
  embedding      Unsupported("vector(1024)")?
  liked          Boolean?
  feedbackAt     DateTime? @map("feedback_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  adviceStatus   String? @map("advice_status")
  adviceErrorCode String? @map("advice_error_code")
  adviceJobId    String? @map("advice_job_id") @db.Uuid
  advicePromptVersion String? @map("advice_prompt_version")
  adviceKnowledgeVersion String? @map("advice_knowledge_version")
  adviceProvider String? @map("advice_provider")
  stylistJobs    StylistJob[]
  savedAt        DateTime? @map("saved_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tryOnJob       TryOnJob @relation(fields: [tryOnJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId, createdAt])
  @@map("outfits")
}

model StyleProfile {
  userId String @id @map("user_id") @db.Uuid
  styles String[] @default([])
  occasions String[] @default([])
  budget Int?
  preferredColors String[] @default([]) @map("preferred_colors")
  avoidedColors String[] @default([]) @map("avoided_colors")
  bodyShape String? @map("body_shape")
  skinTone String? @map("skin_tone")
  tasteVector Unsupported("vector(1024)")? @map("taste_vector")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@map("style_profiles")
}

model StylistJob {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  key String
  requestHash String @map("request_hash")
  kind String
  input Json
  outfitId String? @map("outfit_id") @db.Uuid
  provider String
  model String
  status String @default("queued")
  errorCode String? @map("error_code")
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  result Json?
  deadlineAt DateTime @map("deadline_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  outfit Outfit? @relation(fields:[outfitId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([userId,key])
  @@index([status,deadlineAt])
  @@map("stylist_jobs")
}
