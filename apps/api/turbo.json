{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "src/generated/**"],
      "inputs": ["$TURBO_DEFAULT$", "!src/generated/**"]
    },
    "lint": { "dependsOn": ["build"] },
    "dev": {
      "passThroughEnv": [
        "PORT",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "REDIS_URL",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET",
        "CLERK_AUTHORIZED_PARTIES",
        "CLERK_BILLING_ENABLED",
        "CLERK_PLUS_PLAN_SLUG",
        "CLERK_PRO_PLAN_SLUG",
        "USAGE_FREE_LIMIT",
        "USAGE_PLUS_LIMIT",
        "USAGE_PRO_LIMIT",
        "AI_RATE_LIMIT_PER_MINUTE",
        "AI_MAX_ACTIVE_JOBS",
        "AI_COST_RATES_JSON",
        "IMAGEKIT_PUBLIC_KEY",
        "IMAGEKIT_PRIVATE_KEY",
        "IMAGEKIT_URL_ENDPOINT",
        "OPENAI_API_KEY",
        "OPENAI_VISION_MODEL",
        "OPENAI_EMBEDDING_MODEL",
        "OPENAI_IMAGE_MODEL",
        "TRYON_PROVIDER",
        "STYLIST_PROVIDER",
        "ASSET_PROVIDER",
        "ASSET_GENERATION_ENABLED",
        "ASSET_GENERATION_USER_IDS"
      ]
    }
  }
}
